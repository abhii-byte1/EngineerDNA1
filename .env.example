# Database
DATABASE_URL="postgresql://user:password@localhost:5432/engineerdna"

# App & Server Configuration
PORT=5000
APP_URL="http://localhost:5000"

# AI Service
GEMINI_API_KEY="your-gemini-api-key"

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"

# Cloudflare Turnstile Bot Verification (Public Site Key & Private Secret Key)
# Note: VITE_TURNSTILE_SITE_KEY must be set on Render at BUILD TIME since Vite compiles it into the frontend bundle.
# Test Keys: Site Key = "1x00000000000000000000AA", Secret Key = "1x0000000000000000000000000000000AA"
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Session Security
SESSION_SECRET="your-session-secret-hash"
